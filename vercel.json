{
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/api/portal-page"
    },
    {
      "source": "/portal/",
      "destination": "/api/portal-page"
    },
    {
      "source": "/portal/leads",
      "destination": "/api/leads"
    },
    {
      "source": "/portal/leads/",
      "destination": "/api/leads"
    }
  ],
  "functions": {
    "api/portal-feeds.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/review",
      "destination": "https://g.page/r/CYwv9NBke5OyEBM/review",
      "permanent": false
    },
    {
      "source": "/review/",
      "destination": "https://g.page/r/CYwv9NBke5OyEBM/review",
      "permanent": false
    },
    {
      "source": "/resena",
      "destination": "https://g.page/r/CYwv9NBke5OyEBM/review",
      "permanent": false
    },
    {
      "source": "/resena/",
      "destination": "https://g.page/r/CYwv9NBke5OyEBM/review",
      "permanent": false
    },
    {
      "source": "/shed-demolition",
      "destination": "/junk-removal/",
      "permanent": true
    },
    {
      "source": "/shed-demolition/",
      "destination": "/junk-removal/",
      "permanent": true
    },
    {
      "source": "/es/demolicion-de-cobertizos",
      "destination": "/es/retiro-de-basura/",
      "permanent": true
    },
    {
      "source": "/es/demolicion-de-cobertizos/",
      "destination": "/es/retiro-de-basura/",
      "permanent": true
    }
  ]
}
