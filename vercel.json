{
  "rewrites": [
    { "source": "/portal", "destination": "/api/portal-page" },
    { "source": "/portal/", "destination": "/api/portal-page" }
  ],
  "functions": {
    "api/portal-feeds.js": { "maxDuration": 30 }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
