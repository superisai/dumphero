{
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/api/portal-page"
    },
    {
      "source": "/portal/",
      "destination": "/api/portal-page"
    },
    {
      "source": "/portal/leads",
      "destination": "/api/leads"
    },
    {
      "source": "/portal/leads/",
      "destination": "/api/leads"
    }
  ],
  "functions": {
    "api/portal-feeds.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}